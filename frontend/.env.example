# Same-origin API base — the Next.js rewrite (next.config.mjs) proxies /api/* to BACKEND_ORIGIN.
NEXT_PUBLIC_API_URL=/api

# Where the rewrite forwards /api/* to. Local backend by default.
# In production set this to your deployed backend, e.g. https://project-tracker-rbac.onrender.com
BACKEND_ORIGIN=http://localhost:4000
