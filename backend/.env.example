DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rbac_tracker?schema=public"
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="1d"
CLIENT_ORIGIN="http://localhost:3000"
PORT=4000
NODE_ENV=development

# Mail — "log" prints the invite/reset link to the console, "smtp" sends via Nodemailer/Brevo
MAIL_TRANSPORT="log"
MAIL_FROM="Project Tracker <your-verified-sender@example.com>"
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-brevo-login@smtp-brevo.com"
# SMTP_PASS falls back to BREVO_SMTP_Key when blank
SMTP_PASS=""
BREVO_SMTP_Key=""
